+                            "grouped_gpu_us": grouped_gpu_us, "grouped_host_us": grouped_host_us,
+                            "grouped_speedup": current_gpu_us / grouped_gpu_us,
+                        })
+                    );
+                }
+            }
+        }
+    }
+    Ok(())
