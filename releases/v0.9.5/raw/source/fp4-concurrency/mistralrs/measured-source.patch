+fn probe_permute(values: &mut [u32], state: &mut u64) {
+    for index in (1..values.len()).rev() {
+        *state = state.wrapping_mul(PROBE_RANDOM_MULTIPLIER).wrapping_add(1);
+        values.swap(index, (*state >> 32) as usize % (index + 1));
+    }
